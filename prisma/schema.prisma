generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String                @id @default(uuid())
  email           String?               @unique
  authProvider    AuthProvider          @default(anonymous) @map("auth_provider")
  authProviderId  String?               @map("auth_provider_id")
  profile         Json                  @default("{}")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime?             @map("updated_at")
  consentFlags    Json                  @default("{\"analytics\": false, \"marketing\": false, \"personalization\": false}") @map("consent_flags")
  savedFilters    SavedFilter[]
  searchTelemetry SearchTelemetry[]
  interactions    UserInteraction[]
  savedProperties UserSavedProperties[]

  @@index([email])
  @@index([authProvider, authProviderId])
  @@map("users")
}

model Property {
  id               String                    @id @default(uuid())
  title            String
  description      String?
  price            Decimal                   @db.Decimal(14, 2)
  priceCurrency    String                    @default("USD") @map("price_currency")
  totalMonthlyCost Decimal?                  @map("total_monthly_cost") @db.Decimal(10, 2)
  areaM2           Decimal?                  @map("area_m2") @db.Decimal(10, 2)
  rooms            Int?
  bathrooms        Int?
  propertyType     PropertyType?             @map("property_type")
  listingType      ListingType               @default(sale) @map("listing_type")
  lat              Float
  lng              Float
  geoJson          Json?                     @map("geojson")
  address          String?
  neighborhood     String?
  city             String?
  geoHash          String?                   @map("geo_hash")
  images           Json                      @default("[]")
  amenities        Json                      @default("[]")
  sourceUrl        String?                   @map("source_url")
  sourceId         String?                   @map("source_id")
  isActive         Boolean                   @default(true) @map("is_active")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime?                 @map("updated_at")
  publisherId      String?                   @map("publisher_id") @db.Uuid
  sellerType       SellerType?               @map("seller_type")
  geog             Unsupported("geography")?
  bedrooms         Int?
  listingSubType   String?                   @map("listing_sub_type")
  creditApproved   Boolean?                  @map("credit_approved")
  parking          String?
  publisher        PublisherProfile?         @relation(fields: [publisherId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  interactions     UserInteraction[]
  savedBy          UserSavedProperties[]

  @@index([geoHash])
  @@index([price])
  @@index([totalMonthlyCost])
  @@index([isActive])
  @@index([propertyType, listingType])
  @@index([listingSubType])
  @@index([neighborhood])
  @@index([createdAt])
  @@index([geog], type: Gist)
  @@map("properties")
}

model PublisherProfile {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String     @unique @map("user_id") @db.Uuid
  companyName   String?    @map("company_name") @db.VarChar(255)
  licenseNumber String?    @map("license_number") @db.VarChar(100)
  phone         String?    @db.VarChar(50)
  verified      Boolean?   @default(false)
  createdAt     DateTime?  @default(now()) @map("created_at") @db.Timestamptz(6)
  properties    Property[]

  @@map("publisher_profiles")
}

model UserInteraction {
  id              String          @id @default(uuid())
  userId          String?         @map("user_id")
  propertyId      String          @map("property_id")
  interactionType InteractionType @map("interaction_type")
  swipeDirection  String?         @map("swipe_direction")
  sessionId       String          @map("session_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  metadata        Json            @default("{}")
  property        Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user            User?           @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([propertyId])
  @@index([sessionId, createdAt])
  @@index([interactionType])
  @@index([createdAt])
  @@map("user_interactions")
}

model SavedFilter {
  id         String     @id @default(uuid())
  userId     String     @map("user_id")
  filterName String     @map("filter_name")
  criteria   Json
  isDefault  Boolean    @default(false) @map("is_default")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime?  @map("updated_at")
  role       user_role? @default(FINDER)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
  @@map("saved_filters")
}

model UserSavedProperties {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  propertyId String   @map("property_id")
  tags       Json     @default("[]")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId, createdAt])
  @@index([propertyId])
  @@map("user_saved_properties")
}

model B2BAggregatedMetric {
  id           String     @id @default(uuid())
  metricType   MetricType @map("metric_type")
  zoneGeoHash  String?    @map("zone_geo_hash")
  neighborhood String?    @map("neighborhood")
  timeBucket   TimeBucket @map("time_bucket")
  bucketStart  DateTime   @map("bucket_start")
  metricValue  Decimal    @db.Decimal(16, 6)
  sampleSize   Int        @map("sample_size")
  metadata     Json       @default("{}")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([metricType, zoneGeoHash, neighborhood, timeBucket, bucketStart])
  @@index([metricType, timeBucket, bucketStart])
  @@index([zoneGeoHash, bucketStart])
  @@index([neighborhood, bucketStart])
  @@map("b2b_aggregated_metrics")
}

model SearchTelemetry {
  id               String   @id @default(uuid())
  sessionId        String   @map("session_id")
  userId           String?  @map("user_id")
  filtersApplied   Json     @default("{}") @map("filters_applied")
  results_count    Int      @default(0)
  zoomLevel        Int?     @map("zoom_level")
  searchDurationMs Int?     @map("search_duration_ms")
  createdAt        DateTime @default(now()) @map("created_at")
  user             User?    @relation(fields: [userId], references: [id])

  @@index([sessionId, createdAt])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("search_telemetry")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum AuthProvider {
  anonymous
  google
  apple
  email
}

enum InteractionType {
  SWIPE_LEFT
  SWIPE_RIGHT
  SUPERLIKE
  VIEW_DETAIL
  CONTACT_REALTOR
  SAVE
  SHARE
}

enum MetricType {
  SWIPE_RIGHT_RATE
  SWIPE_LEFT_RATE
  SUPERLIKE_RATE
  AVG_PRICE_VIEWED
  AVG_SESSION_DURATION
  PROPERTIES_VIEWED
  DETAIL_VIEW_RATE
  CONTACT_RATE
  SAVE_RATE
}

enum TimeBucket {
  hourly
  daily
  weekly
  monthly
}

enum PropertyType {
  apartment
  house
  condo
  land
  commercial
}

enum ListingType {
  sale
  rent
}

model ContactMessage {
  id            String    @id @default(uuid())
  propertyId    String    @map("property_id")
  propertyTitle String    @map("property_title")
  senderName    String    @map("sender_name")
  senderEmail   String    @map("sender_email")
  senderPhone   String?   @map("sender_phone")
  message       String    @db.Text
  recipientId   String?   @map("recipient_id")
  status        String    @default("new") @map("status")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([recipientId, createdAt])
  @@index([propertyId])
  @@map("contact_messages")
}

enum SellerType {
  OWNER
  AGENCY
}

enum user_role {
  FINDER
  REALTOR
  OWNER
  DEVELOPER_B2B
}
